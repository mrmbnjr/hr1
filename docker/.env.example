# Copy this file to docker/.env and replace the database passwords before use.
# Do not share docker/.env or use these example values on an internet-facing server.

DOCKER_DB_NAME=hr1_db
DOCKER_DB_USER=hr1
DOCKER_DB_PASSWORD=replace-with-a-unique-database-password
DOCKER_MYSQL_ROOT_PASSWORD=replace-with-a-different-unique-root-password

# Keep false unless this is a disposable demo that should include sample users
# (the seeded accounts all use the documented password "admin123").
DOCKER_SEED_DEMO_DATA=false

# Change this if port 8080 is already in use on the host.
DOCKER_HTTP_PORT=8080

DOCKER_APP_ENV=production
DOCKER_APP_DEBUG=false
APP_TIMEZONE=Asia/Manila

# Optional app integrations. Configure these to enable AI analysis and email.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=60
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="RAM-YUM Recruitment"
HR_NOTIFICATION_EMAIL=
